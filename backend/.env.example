# ====================================================================
# AI-Based Social Media Sentiment & Reputation Analysis System
# Environment Configuration Template (.env.example)
# ====================================================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Leave blank to use default local SQLite (db.sqlite3).
# For PostgreSQL production, set:
# DATABASE_URL=postgresql://user:password@localhost:5432/sentiment_db
DATABASE_URL=

# CORS Configuration
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ML Model Directory (Leave blank to use default backend/ml_models)
MODEL_DIRECTORY=

# ====================================================================
# Twitter / X Official API Credentials (Optional - App runs without them)
# ====================================================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ====================================================================
# Meta / Instagram Graph API Credentials (Optional - App runs without them)
# ====================================================================
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
